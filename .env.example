# Square — online ordering
# Copy this file to .env.local and fill in the Sandbox values while building.

# "sandbox" while building, "production" at launch. Controls which base URL
# lib/square.ts points the client at.
SQUARE_ENV=sandbox

# From developer.squareup.com -> your app -> Sandbox tab
SQUARE_ACCESS_TOKEN=
SQUARE_APPLICATION_ID=
SQUARE_LOCATION_ID=

# Square dashboard -> Webhooks -> signature key.
SQUARE_WEBHOOK_SIGNATURE_KEY=

# --- Notifications (email only) ---
# Twilio SendGrid. ORDER_FROM_EMAIL must be a verified Sender in SendGrid.
# ORDER_ALERT_EMAIL is the inbox that receives new-order alerts (the shop).
SENDGRID_API_KEY=
ORDER_FROM_EMAIL=
ORDER_ALERT_EMAIL=
# Reply-to on customer confirmations (the shop inbox customers reach on reply).
CUSTOMER_REPLY_TO_EMAIL=

# --- Google reCAPTCHA v3 ---
# Create keys at https://www.google.com/recaptcha/admin (choose "Score based v3").
# SITE key is public (shipped to the browser); SECRET is server-only.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5

# =====================================================================
# Off-Square rebuild (custom item + order management). See the plan.
# =====================================================================

# --- Vercel Postgres / Neon ---
# DATABASE_URL is the POOLED connection string (host contains "-pooler"); the app
# uses it at runtime. POSTGRES_URL_NON_POOLING is the DIRECT string; drizzle-kit
# migrations use it. Vercel injects both when you add the Postgres integration —
# for local dev, copy them from the Vercel project's Storage tab.
DATABASE_URL=
POSTGRES_URL_NON_POOLING=

# --- UploadThing product photos ---
# From uploadthing.com -> your app -> API Keys. One token for the current SDK.
UPLOADTHING_TOKEN=

# --- Admin auth single admin login, no registration ---
# AUTH_SECRET: random 32+ byte secret used to sign the session cookie.
#   Generate: openssl rand -base64 32
# ADMIN_PASSWORD_HASH: base64-encoded bcrypt hash of the one admin password
#   (base64 so it has no `$`, which Next.js would otherwise expand and corrupt).
#   Generate: npm run admin:hash   (prompts securely; copy the printed line)
AUTH_SECRET=
ADMIN_PASSWORD_HASH=
