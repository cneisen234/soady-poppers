# Square — online ordering
# Copy this file to .env.local and fill in the Sandbox values while building.
# At go-live (Step 7) swap SQUARE_ENV to "production" and paste the client's
# Production credentials. .env.local is gitignored; this template is committed.

# "sandbox" while building, "production" at launch. Controls which base URL
# lib/square.ts points the client at.
SQUARE_ENV=sandbox

# From developer.squareup.com -> your app -> Sandbox tab
SQUARE_ACCESS_TOKEN=
SQUARE_APPLICATION_ID=
SQUARE_LOCATION_ID=

# Set later, in Step 6 (Notifications). Square dashboard -> Webhooks -> signature key.
SQUARE_WEBHOOK_SIGNATURE_KEY=

# --- Notifications (email only) ---
# Twilio SendGrid. ORDER_FROM_EMAIL must be a verified Sender in SendGrid.
# ORDER_ALERT_EMAIL is the inbox that receives new-order alerts (the shop).
SENDGRID_API_KEY=
ORDER_FROM_EMAIL=
ORDER_ALERT_EMAIL=
# Reply-to on customer confirmations (the shop inbox customers reach on reply).
CUSTOMER_REPLY_TO_EMAIL=

# --- Google reCAPTCHA v3 ---
# Create keys at https://www.google.com/recaptcha/admin (choose "Score based v3").
# SITE key is public (shipped to the browser); SECRET is server-only.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5
